/**
 * Function _busca_plan
 * @param string $titulo
 *
 * @return int $nid
 */
function _busca_plan($titulo, $periodo_efectivo)
{
  custom_var_dump('-----_busca_plan');
  if (!empty($titulo)) {
    $query = \Drupal::entityQuery('node');
    $query->condition('status', 1);
    $query->condition('type', 'plan_estudios');
    $query->condition('field_plan_estudios_per_efec', "$periodo_efectivo");
    $query->condition('title', $titulo);
    $query->range(0, 1);
    $asignatura = $query->execute();
    return reset($asignatura);
  }
  return 0;
}

/**
 * Function _busca_plan
 * @param string $titulo
 *
 * @return int $nid
 */
function _crea_plan($titulo, $periodo_efectivo)
{
  $plan_estudio = Node::create(['type' => 'plan_estudios']);
  $plan_estudio->enforceIsNew();
  $plan_estudio->status = 1;
  $plan_estudio->field_plan_estudios_per_efec = "$periodo_efectivo";
  $plan_estudio->set('title', $titulo);
  $plan_estudio->save();
  return $plan_estudio->id();
}

/**
 * Function _busca_asignatura
 * @param string $materia
 * @param int $curso
 * @param int $periodo_efect
 *
 * @return int $nid
 */
function _busca_asignatura($materia, $curso, $periodo_efect)
{
  if (!empty($materia) && !empty($curso) && !empty($periodo_efect)) {
    $query = \Drupal::entityQuery('node');
    $query->condition('status', 1);
    $query->condition('type', 'szvcata');
    $query->condition('field_curso', $curso);
    $query->condition('field_materia', $materia);
    //$query->condition('field_periodo_efectivo', $periodo_efect);
    $query->range(0, 1);
    $asignatura = $query->execute();
    return reset($asignatura);
  }
  return 0;
}

function get_bloque_academico_plan_estudio_semestre(&$plan_estudio, $datos, $asignatura_id)
{
  custom_var_dump('-----get_bloque_academico_plan_estudio_semestre');
  $bloques_ids = $plan_estudio->field_plan_estudios_asignaturas->getValue();
  // BUSCA SI EXISTE Y RETORNA
  foreach ($bloques_ids as $key => $bloque_id) {
    $bloque = Paragraph::load($bloque_id['target_id']);
    if (
      !$bloque->field_semestre->isEmpty() &&
      !$bloque->field_plan_estudios_asig_seme->isEmpty()
    ) {
      $field_semestre = $bloque->field_semestre->getValue();
      $asignatura_sem_id = $bloque->field_plan_estudios_asig_seme->getValue();
      $semestre = Term::load($field_semestre[0]['target_id']);
      if (
        $semestre->getName() == $datos[0] &&
        $asignatura_sem_id[0]['target_id'] == $asignatura_id
      ) {
        return $bloque;
      }
    }
  }

  // SI NO EXISTE LO CREA
  $query = \Drupal::entityQuery('taxonomy_term')
    ->condition('vid', 'bloque_academico')
    ->condition('name', $datos[0])
    ->range(0, 1);
  $semestre_id = $query->execute();
  $semestre_id = reset($semestre_id);
  $asignatura = Node::load($asignatura_id);

  $bloque = Paragraph::create([
    'type' => 'bloque_academico',
    'field_plan_estudios_asig_seme' => $asignatura,
    'field_semestre' => array('target_id' => $semestre_id),
    'field_plan_estudios_area' => $datos[1],
    'field_plan_estudios_flexibilidad' => $datos[2],
    'field_plan_estudios_keys' => $datos[3],
    'field_plan_estudios_descripcion' => $datos[4],
    'field_plan_estudios_observacione' => $datos[5],
  ]);
  $bloque->save();

  $plan_estudio->field_plan_estudios_asignaturas->appendItem($bloque);
  $plan_estudio->setNewRevision(TRUE);
  $plan_estudio->revision_log->value = "AUTOMATED-UPDATE Adicion de asignatura";
  $plan_estudio->save();

  \Drupal::messenger()->addStatus('Bloque creado:' . $datos[0]);
  return $bloque;
}


function asociar_regla_plan_estudio_electiva($asignatura, &$context)
{
  $context['message'] = 'Creando Regla Plan de estudios: ' . $asignatura[8] . '-' . $asignatura[6] . $asignatura[7];
  $asignatura_id = _busca_asignatura($asignatura[6], $asignatura[7], $asignatura[8]);

  if (!empty($asignatura_id)) {

    $plan_estudio_id = $context['results']['planes']['original']['id'];
    $plan_estudio = Node::load($plan_estudio_id);

    $asignatura_node = Node::load($asignatura_id);
    if (!empty($asignatura_node)) {
      $asignatura_titulo = $asignatura_node->getTitle();
      timerSlow();
      if (strpos($asignatura_titulo, 'ELECTIVA')) {
        $regla = _procesa_regla_plan_estudio_electiva($asignatura_node);
        $plan_estudio->field_regla[] = $regla;
        $plan_estudio->setNewRevision(TRUE);
        $plan_estudio->revision_log->value = "AUTOMATED-UPDATE Adicion de Regla";
        $plan_estudio->save();
      }
    }
  }
}

function _procesa_regla_plan_estudio_electiva($asignatura_node)
{
  custom_var_dump('-----_procesa_regla_plan_estudio_electiva');

  $asignatura_titulo = $asignatura_node->getTitle();
  $regla_titulo = 'Electiva - ' . $asignatura_titulo;

  // BUSCA LA REGLA SI EXISTE
  $regla_id = _busca_regla($regla_titulo);

  if (empty($regla_id)) {
    $regla = Node::create(['type' => 'reglas_programa']);
    $regla->enforceIsNew();
    $regla->status = 1;
    $regla->field_reglas_electiva_enfasis = 'Electiva';
    $regla->title = $regla_titulo;
    $regla->field_prog_materia[] = $asignatura_node;
  } else {
    $regla = Node::load($regla_id);
    $regla->field_prog_materia[] = $asignatura_node;
  }
  $regla->save();
  timerSlow();
  \Drupal::messenger()->addStatus('Regla creada:' . $regla_titulo);
  return $regla;
}

function _busca_regla($titulo)
{
  custom_var_dump('-----_busca_regla');
  if (!empty($titulo)) {
    $query = \Drupal::entityQuery('node');
    $query->condition('status', 1);
    $query->condition('type', 'reglas_programa');
    $query->condition('title', $titulo);
    $query->range(0, 1);
    $asignatura = $query->execute();
    return reset($asignatura);
  }
  return 0;
}

function timerSlow()
{
  usleep(0.1 * 1000000);
}

/**
 * Implements hook_theme().
 */
function plan_estudios_theme($existing, $type, $theme, $path) {
  return [
    'my_template' => [
      'variables' => [
        'titulos' => NULL,
        'variables' => NULL,
      ],
    ],
  ];
}
